{
	"info": {
		"_postman_id": "8a8f8d9b-1234-4567-890a-bcdef1234567",
		"name": "Jelajah Sejarah API (Automated)",
		"description": "API Jelajah Sejarah - Klik & Play (Otomatis Handle Token & ID)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Auth & Setup",
			"item": [
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.access_token);",
									"    console.log(\"Token otomatis tersimpan!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@sejarah.id\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Get Me (Check Token)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
						},
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "2. Explorasi (Data Discovery)",
			"item": [
				{
					"name": "List Eras (Auto-Save Slug)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.length > 0) {",
									"    pm.collectionVariables.set(\"era_slug\", jsonData.data[0].slug);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/eras",
							"host": ["{{base_url}}"],
							"path": ["eras"]
						}
					}
				},
				{
					"name": "List Articles (Auto-Save Slug & ID)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.length > 0) {",
									"    var firstArt = jsonData.data[0];",
									"    pm.collectionVariables.set(\"article_slug\", firstArt.slug);",
									"    pm.collectionVariables.set(\"article_id\", firstArt.id);",
									"    console.log(\"Article Slug & ID Berhasil Diambil!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/articles",
							"host": ["{{base_url}}"],
							"path": ["articles"]
						}
					}
				}
			]
		},
		{
			"name": "3. Fitur Interaktif (Automated)",
			"item": [
				{
					"name": "Get Article Detail",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/articles/{{article_slug}}",
							"host": ["{{base_url}}"],
							"path": ["articles", "{{article_slug}}"]
						}
					}
				},
				{
					"name": "Toggle Bookmark",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
						},
						"method": "POST",
						"url": {
							"raw": "{{base_url}}/bookmarks/{{article_id}}",
							"host": ["{{base_url}}"],
							"path": ["bookmarks", "{{article_id}}"]
						}
					}
				},
				{
					"name": "Submit Quiz",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"score\": 8,\n    \"total\": 10,\n    \"time_seconds\": 45\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/articles/{{article_slug}}/quiz-attempt",
							"host": ["{{base_url}}"],
							"path": ["articles", "{{article_slug}}", "quiz-attempt"]
						}
					}
				},
				{
					"name": "Update Reading Progress",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
						},
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "Content-Type", "value": "application/json", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"progress_percent\": 100\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/progress/{{article_id}}",
							"host": ["{{base_url}}"],
							"path": ["progress", "{{article_id}}"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
		{ "key": "token", "value": "", "type": "string" },
		{ "key": "article_slug", "value": "", "type": "string" },
		{ "key": "article_id", "value": "", "type": "string" },
		{ "key": "era_slug", "value": "", "type": "string" }
	]
}